#!/usr/bin/env bash

mkcd() {
    mkdir -p "$1" && cd "$1"
}


file_exists() {
# variables inside a function have global scope

# makes the variable local to this function
   local file="$1"


    #if [[ -f "$file" ]]; then
    #     return 0
    #else
    #     return 1
    #fi
    [[ -f "$file" ]] || return 1 #this code is equivalent to the earlier code
}

bak() {
    local file="$1"
    file_exists "$file"
    local backup="$file.bak.$(date +%Y%m%d_%H%M%S)"
    cp "$file" "$backup"
}
